#!/usr/bin/env bash
# Attach to this container's herdr session with two tabs: opencode, and a plain
# zsh shell. `devpod up` runs this on every boot, so it must be idempotent --
# and it must repair a session whose opencode has since exited, not just check
# that a workspace exists.
set -euo pipefail

cd "${1:-$PWD}"

# The herdr CLI talks to a background server and will not start one itself
# ("run `herdr` to start or attach it"), but bare `herdr` launches the TUI.
# setsid so the server outlives the ssh session that started it.
if ! herdr status server 2>/dev/null | grep -q '^status: running'; then
    setsid herdr server >/tmp/herdr-server.log 2>&1 </dev/null &
    for _ in $(seq 50); do
        herdr status server 2>/dev/null | grep -q '^status: running' && break
        sleep 0.1
    done
fi

# Build the layout only when there is no session yet. Creating a workspace also
# creates its first tab and root pane, so tab 1 becomes opencode and we add zsh.
if [ "$(herdr workspace list | jq '.result.workspaces | length')" -eq 0 ]; then
    created=$(herdr workspace create --cwd "$PWD" --label "${PWD##*/}" --no-focus)
    ws=$(jq -r '.result.workspace.workspace_id' <<<"$created")
    herdr tab rename "$(jq -r '.result.tab.tab_id' <<<"$created")" opencode >/dev/null
    herdr tab create --workspace "$ws" --label zsh --cwd "$PWD" --no-focus >/dev/null
fi

# opencode exits (crash, ctrl-c, or a killed client) leaving a tab still called
# "opencode" running a bare shell. Restart it whenever it is not the pane's
# foreground process, so re-attaching always lands on a live agent.
tab=$(herdr tab list | jq -r 'first(.result.tabs[] | select(.label == "opencode") | .tab_id) // empty')
if [ -n "$tab" ]; then
    pane=$(herdr pane list | jq -r --arg t "$tab" 'first(.result.panes[] | select(.tab_id == $t) | .pane_id) // empty')
    if [ -n "$pane" ]; then
        fg=$(herdr pane process-info --pane "$pane" \
             | jq -r '[.result.process_info.foreground_processes[].name] | join(" ")')
        case " $fg " in
            *" opencode "*) ;;
            *) herdr pane run "$pane" opencode >/dev/null ;;
        esac
    fi
fi

exec herdr
