{
  "$schema": "https://opencode.ai/config.json",
  "model": "minimax-coding-plan/MiniMax-M3",
  "small_model": "minimax-coding-plan/MiniMax-M3",
  "disabled_providers": ["minimax", "minimax-cn", "minimax-cn-coding-plan"],
  "mcp": {
    "shadcn": {
      "type": "local",
      "enabled": true,
      "command": ["bunx", "-y", "shadcn@latest", "mcp"]
    },
    "mastra": {
      "type": "local",
      "enabled": true,
      "command": ["bunx", "-y", "@mastra/mcp-docs-server@latest"]
    },
    "elysiajs": {
      "type": "remote",
      "enabled": true,
      "url": "https://gitmcp.io/elysiajs/documentation"
    },
    "clerk": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.clerk.com/mcp"
    },
    "context7": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.context7.com/mcp",
      "headers": { "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}" }
    }
  }
}
